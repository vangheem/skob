# skob process. `skob serve` reads these names.
SKOB_ROLE=all
SKOB_BIND=0.0.0.0:8080
SKOB_DATA_DIR=./data
SKOB_NODE_ID=1
SKOB_ADVERTISE=http://127.0.0.1:8080
SKOB_BLOB=s3
SKOB_S3_ENDPOINT=http://127.0.0.1:9000
SKOB_S3_BUCKET=skob
SKOB_S3_REGION=us-east-1
SKOB_S3_ACCESS_KEY=rustfsadmin
SKOB_S3_SECRET_KEY=rustfsadmin
SKOB_S3_PATH_STYLE=true
SKOB_SEGMENT_COUNT=256
SKOB_PG_BIND=0.0.0.0:5432

# RustFS credentials used by docker compose.
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
